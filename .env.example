# Secreto criptográfico obligatorio en producción para cifrar cookies HttpOnly (mín. 32 caracteres aleatorios)
SESSION_ENCRYPTION_SECRET=cambia_esto_por_un_secreto_aleatorio_largo_en_vercel

# Secreto para proteger el endpoint cron /api/keepalive en producción
CRON_SECRET=cambia_esto_por_un_secreto_cron_en_vercel

# Credenciales opcionales de Garmin Connect para sincronización en desarrollo local
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña_aqui

# Conexión Supabase (Memoria en la nube para rutinas e historial)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon_de_supabase
